# ==============================================================================
# MIST ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLERK AUTHENTICATION (SOLE IDENTITY PROVIDER)
# ------------------------------------------------------------------------------
# Frontend publishable key (exposed to browser via Vite bundle)
# Obtain from Clerk Dashboard > API Keys
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."

# Sentry DSN for frontend error and performance monitoring
VITE_SENTRY_DSN="https://d0c0e5b705103eb6df2c84e69fae200d@o4512470558769152.ingest.us.sentry.io/4512478355521536"

# Backend secret key (used strictly by Heroku backend for session verification)
# Obtain from Clerk Dashboard > API Keys
CLERK_SECRET_KEY="sk_test_..."

# ------------------------------------------------------------------------------
# 2. FIREBASE FIRESTORE (DATABASE ONLY - STRICTLY VIA ADMIN SDK)
# ------------------------------------------------------------------------------
# Firebase Project ID (e.g., lithe-sensor-2v0ns)
FIREBASE_PROJECT_ID="your-firebase-project-id"

# Optional specific Firestore Database ID (leave as (default) or set if using a named database)
FIREBASE_DATABASE_ID="(default)"

# Firebase Service Account JSON (REQUIRED on Heroku backend)
# Set as a single-line minified JSON string or an absolute file path.
# Obtain from Google Cloud / Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# NEVER commit the actual service account JSON file into source control.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# ------------------------------------------------------------------------------
# 3. CLOUDFLARE R2 ARTIFACT STORAGE (PUBLISHED SITES)
# ------------------------------------------------------------------------------
# Cloudflare Account ID (obtain from Cloudflare Dashboard URL or Overview)
CLOUDFLARE_R2_ACCOUNT_ID="your_cloudflare_account_id"

# Cloudflare R2 S3-Compatible API Credentials
# Obtain from Cloudflare Dashboard > R2 > Manage R2 API Tokens > Create API Token
# Permissions: Object Read & Write on bucket 'mist-published-sites'
CLOUDFLARE_R2_ACCESS_KEY_ID="your_r2_access_key_id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"

# R2 Bucket Name (default: mist-published-sites)
CLOUDFLARE_R2_BUCKET="mist-published-sites"

# ------------------------------------------------------------------------------
# 4. EDGE ORIGIN SECURITY (CLOUDFLARE WORKER -> HEROKU CONTROL PLANE)
# ------------------------------------------------------------------------------
# Shared secret to ensure Heroku accepts requests only when routed through Cloudflare edge.
# Generate with: openssl rand -hex 32
# Configure identically in Cloudflare Worker secret and Heroku config var.
MIST_EDGE_ORIGIN_SECRET="generate_random_32_byte_hex_secret"

# ------------------------------------------------------------------------------
# 5. DOMAIN & HOSTING URLS
# ------------------------------------------------------------------------------
# Apex domain for Mist
APEX_DOMAIN="mist.me"

# Public application builder URL
PUBLIC_APP_URL="https://mist.me"

# Dedicated publishing origin for user-published websites (isolated from builder origin).
# e.g. "https://sites.mist.me" or wildcard "https://*.mist-sites.com" or "https://mist-published.com"
# If omitted or empty, public website publishing is safely disabled while keeping project export functional.
PUBLISH_BASE_URL="https://sites.mist.me"

# Heroku backend origin (configured in Cloudflare Worker to proxy /api/* requests)
HEROKU_API_ORIGIN="https://mist-control-plane-api.herokuapp.com"

# ------------------------------------------------------------------------------
# 6. ENCRYPTION VAULT & PUSH NOTIFICATIONS
# ------------------------------------------------------------------------------
# Server secret for encrypting user BYOK API keys using AES-256-GCM.
# REQUIRED in production: Must be at least 32 high-entropy characters.
# Generate with: openssl rand -hex 32
# Predictable words, placeholders, or short strings are strictly rejected in production.
MIST_VAULT_SECRET="generate_random_32_byte_hex_secret"

# Optional previous secrets for zero-downtime key rotation (comma-separated list).
# When rotating MIST_VAULT_SECRET, place the previous secret(s) here. The server will unseal
# records encrypted under older keys and transparently re-encrypt them with MIST_VAULT_SECRET JIT.
# MIST_VAULT_PREVIOUS_SECRETS="previous_secret_1,previous_secret_2"
MIST_VAULT_PREVIOUS_SECRETS=""

# Optional legacy migration flag ("true" | "false", defaults to "false" in production).
# Set to "true" to enable decrypting legacy vault records encrypted with the old dev fallback key
# (${FIREBASE_PROJECT_ID}:mist-account-vault-dev-only) and automatically re-encrypt them under MIST_VAULT_SECRET.
ALLOW_LEGACY_VAULT_MIGRATION="false"

# Web Push VAPID credentials (generated automatically if omitted)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@mist.me"

# ------------------------------------------------------------------------------
# 7. AI & SEARCH PROVIDER CREDENTIALS
# ------------------------------------------------------------------------------
# Optional server-fallback AI keys (users can also provide keys via encrypted BYOK vault)
GEMINI_API_KEY=""
BRAVE_SEARCH_API_KEY=""
