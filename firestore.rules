rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Mist Production Security Architecture:
    // Direct client-side Firestore access from web browsers is completely disabled.
    // Cloud Firestore is used purely as a private backend database.
    // All queries, mutations, transactions, and batched writes are executed
    // by the trusted Mist Heroku control-plane API using the Firebase Admin SDK.
    // The backend validates Clerk session identity and enforces strict ownership.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
