{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/refs/heads/v2/crates/tauri-cli/schema.json",
  "productName": "Stroke",
  "version": "0.1.0",
  "identifier": "com.stroke.cyberpunk",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://127.0.0.1:8501",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stroke // Cyberpunk Matrix Operations",
        "width": 1360,
        "height": 880,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#050505"
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
